{
  "name": "shubham-portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-messages",
      "database_id": "local-dev-placeholder"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local"
  }
}
